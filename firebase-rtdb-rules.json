{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["type", "name"],
      "$roomId": {
        ".write": "auth != null",
        "messages": {
          ".write": "auth != null"
        }
      }
    },

    "presence": {
      ".read": "auth != null",
      "$roomId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "roomLive": {
      "$roomId": {
        ".read": "auth != null",
        "videoState": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        }
      }
    }
  }
}
