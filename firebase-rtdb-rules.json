{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["name"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "community": {
      ".read": "auth != null",
      "posts": {
        ".indexOn": ["createdAt"],
        "$postId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('authorId').val() === auth.uid))",
          "votes": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid"
            }
          },
          "commentCount": {
            ".write": "auth != null"
          }
        }
      },
      "comments": {
        "$postId": {
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('authorId').val() === auth.uid))"
          }
        }
      },
      "postAttachments": {
        ".write": "auth != null"
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && ($from === auth.uid || $uid === auth.uid)"
        }
      }
    },

    "dms": {
      "$threadId": {
        ".read": "auth != null && $threadId.contains(auth.uid)",
        ".write": "auth != null && $threadId.contains(auth.uid)"
      }
    },

    "dmThreads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },

    "reports": {
      ".write": "auth != null"
    },

    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["type", "name"],
      "$roomId": {
        ".write": "auth != null",
        "messages": {
          ".write": "auth != null"
        }
      }
    },

    "presence": {
      ".read": "auth != null",
      "$roomId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "roomLive": {
      "$roomId": {
        ".read": "auth != null",
        "activeTool": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "videoState": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "whiteboard": {
          ".write": "auth != null"
        },
        "voice": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid)"
          }
        },
        "hands": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid)"
          }
        }
      }
    }
  }
}
