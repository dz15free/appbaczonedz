{
  "rules": {
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "name",
        "email",
        "points",
        "role",
        "track"
      ],
      "$uid": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && (!newData.hasChild('role') || newData.child('role').val() === 'student' || newData.child('role').val() === 'teacher')) || (auth.uid === $uid && data.exists() && (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val())))",
        "points": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('users').child(auth.uid).child('role').val() === 'admin' || !data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 60))"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        }
      }
    },
    "community": {
      ".read": "auth != null",
      "posts": {
        ".indexOn": [
          "createdAt",
          "authorId"
        ],
        "$postId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && newData.exists() && data.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('authorId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')))",
          "votes": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid"
            }
          },
          "commentCount": {
            ".write": "auth != null"
          },
          "locked": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
          }
        }
      },
      "comments": {
        "$postId": {
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('authorId').val() === auth.uid || root.child('community').child('posts').child($postId).child('authorId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')))"
          }
        }
      },
      "postAttachments": {
        ".write": "auth != null"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && ($from === auth.uid || $uid === auth.uid)"
        }
      }
    },
    "sentRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "dms": {
      "$threadId": {
        ".read": "auth != null && $threadId.contains(auth.uid)",
        ".write": "auth != null && $threadId.contains(auth.uid)"
      }
    },
    "dmThreads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null",
      "$reportKey": {
        ".write": "auth != null && (!data.exists() || auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "!newData.exists() || newData.hasChildren(['kind','createdAt'])"
      }
    },
    "groups": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt",
        "subject",
        "name"
      ],
      "$groupId": {
        ".write": "auth != null && (!data.exists() && newData.child('ownerId').val() === auth.uid || (data.exists() && !newData.exists() && data.child('ownerId').val() === auth.uid))"
      }
    },
    "groupMembers": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('groups').child($groupId).child('ownerId').val() === auth.uid",
        "$uid": {
          ".write": "auth != null && ($uid === auth.uid || root.child('groups').child($groupId).child('ownerId').val() === auth.uid)"
        }
      }
    },
    "groupMessages": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "createdAt"
        ]
      }
    },
    "groupFiles": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "userGroups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "type",
        "name"
      ],
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('ownerId').val() === auth.uid",
        "messages": {
          ".write": "auth != null"
        },
        "attachments": {
          ".write": "auth != null"
        },
        "files": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || (newData.exists() && newData.child('uploaderId').val() === auth.uid) || (data.exists() && data.child('uploaderId').val() === auth.uid))"
        }
      }
    },
    "notesDraft": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
        ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200000)"
      }
    },
    "scheduledSessions": {
      ".read": "auth != null",
      "$sessionId": {
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid)"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$roomId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "flashcards": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "studyProgress": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "lessons": {
          "$lessonId": {
            ".validate": "newData.isString() && newData.val().matches(/^(todo|partial|done)$/)"
          }
        }
      }
    },
    "bannedUsers": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        }
      }
    },
    "roomLive": {
      "$roomId": {
        ".read": "auth != null",
        "mods": {
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
          }
        },
        "poll": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
          "votes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "kicked": {
          "$uid": {
            ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
          }
        },
        "activeTool": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
        },
        "roomState": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
        },
        "videoState": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "whiteboard": {
          ".write": "auth != null"
        },
        "voice": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
          }
        },
        "hands": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
          }
        },
        "timer": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
          ".read": "auth != null"
        },
        "notes": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
          ".read": "auth != null",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200000)"
        },
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "activeFile": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "ownerStatus": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "welcomeMsg": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "pdfSync": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "anonQuestions": {
          "$qid": {
            ".write": "auth != null && (!data.exists() || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid)"
          }
        },
        "challenge": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "marks": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "exam": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['status','examUrl','durationMin','startedAt','endsAt']) && newData.child('status').val().matches(/^(running|ended)$/) && newData.child('endsAt').isNumber() && newData.child('durationMin').isNumber())"
        }
      }
    },
    "library": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uploaderId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uploaderId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')) || (data.exists() && newData.exists() && (data.child('uploaderId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && newData.child('uploaderId').val() === data.child('uploaderId').val()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['title','fileUrl','uploaderId']) && newData.child('title').val().length <= 200 && newData.child('fileUrl').isString())"
      },
      ".indexOn": [
        "createdAt"
      ]
    },
    "studyTasks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "accessCodes": {
      ".read": "auth != null",
      ".indexOn": [
        "createdBy",
        "code",
        "createdAt",
        "ownerId"
      ],
      "$codeId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && (root.child('users').child(auth.uid).child('role').val() === 'teacher' || root.child('users').child(auth.uid).child('role').val() === 'admin') && ((newData.child('itemType').val() === 'course' && root.child('courses').child(newData.child('itemId').val()).child('teacherId').val() === auth.uid) || (newData.child('itemType').val() === 'library' && root.child('library').child(newData.child('itemId').val()).child('uploaderId').val() === auth.uid) || (newData.child('itemType').val() === 'room' && root.child('rooms').child(newData.child('itemId').val()).child('ownerId').val() === auth.uid)) && newData.child('createdBy').val() === auth.uid && newData.child('ownerId').val() === auth.uid && !newData.hasChild('redeemedBy')) || (data.exists() && !data.child('redeemedBy').exists() && newData.child('redeemedBy').val() === auth.uid && newData.child('itemType').val() === data.child('itemType').val() && newData.child('itemId').val() === data.child('itemId').val() && newData.child('price').val() === data.child('price').val() && newData.child('ownerId').val() === data.child('ownerId').val() && newData.child('createdBy').val() === data.child('createdBy').val() && newData.child('createdAt').val() === data.child('createdAt').val()))"
      }
    },
    "userAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$itemType": {
          "$itemId": {
            ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || (!newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
            ".validate": "!newData.exists() || (newData.isString() && root.child('accessCodes').child(newData.val()).child('redeemedBy').val() === auth.uid && root.child('accessCodes').child(newData.val()).child('itemId').val() === $itemId)"
          }
        }
      }
    },
    "roomChallengeAnswers": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
        ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['name','at']) && (newData.child('text').val().length > 0 || newData.hasChild('attachment'))"
        }
      }
    },
    "roomChallengeScores": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
      }
    },
    "roomSummaries": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
      }
    },
    "attendance": {
      "$teacherUid": {
        ".read": "auth != null",
        "$studentUid": {
          ".write": "auth != null && auth.uid === $studentUid && !data.exists()",
          ".validate": "newData.hasChild('at')"
        }
      }
    },
    "teacherRatings": {
      "$teacherUid": {
        ".read": "auth != null",
        "$studentUid": {
          ".write": "auth != null && ((auth.uid === $studentUid && $studentUid !== $teacherUid && root.child('attendance').child($teacherUid).child(auth.uid).child('at').exists() && root.child('attendance').child($teacherUid).child(auth.uid).child('at').val() < (now - 600000)) || (!newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "!newData.exists() || (newData.hasChildren(['stars','studentName','at']) && newData.child('stars').isNumber() && newData.child('stars').val() >= 1 && newData.child('stars').val() <= 5 && (!newData.hasChild('comment') || newData.child('comment').val().length <= 500))"
        }
      }
    },
    "purchases": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$itemType": {
          "$itemId": {
            ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || (!newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
            ".validate": "root.child('accessCodes').child(newData.val()).child('redeemedBy').val() === auth.uid && root.child('accessCodes').child(newData.val()).child('itemId').val() === $itemId"
          }
        }
      }
    },
    "contentRatings": {
      "$itemId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && root.child('purchases').child(auth.uid).child('library').child($itemId).exists()) || (!newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "!newData.exists() || (newData.hasChildren(['stars','name','at']) && newData.child('stars').isNumber() && newData.child('stars').val() >= 1 && newData.child('stars').val() <= 5 && (!newData.hasChild('comment') || newData.child('comment').val().length <= 500))"
        }
      }
    },
    "curriculum": {
      ".read": "auth != null",
      "lessons": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".indexOn": [
          "stream",
          "subject"
        ],
        "$lessonKey": {
          ".validate": "newData.hasChildren(['title','subject','stream']) && newData.child('title').isString() && newData.child('title').val().length <= 300 && newData.child('subject').isString() && newData.child('subject').val().length <= 120 && newData.child('stream').isString() && newData.child('stream').val().length <= 120"
        }
      },
      "hiddenSubjects": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$key": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "siteSubjects": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$subjectId": {
        ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 120"
      }
    },
    "broadcasts": {
      // ══ الإشارة الجماعية @all ══
      // سجلّ واحد يقرؤه الجميع بدل إشعار لكل مستخدم: تكلفة الكتابة
      // ثابتة مهما بلغ عدد الطلبة.
      ".read": "auth != null",
      "$id": {
        // الأدمن وحده يبثّ للموقع كلّه. والأستاذ داخل غرفته: يُتحقّق
        // من ملكيته للغرفة لا من دور تُرسله الواجهة.
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.child('scope').val() !== 'site' && root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('rooms').child(newData.child('scopeId').val()).child('ownerId').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['text','scope','fromUid','createdAt']) && newData.child('fromUid').val() === auth.uid && newData.child('text').val().length <= 300 && newData.child('scope').val().matches(/^(site|room|group)$/))"
      }
    },
    "broadcastReads": {
      // «مقروء» عند القارئ لا في البثّ — وإلّا احتاج كل قارئ صلاحية
      // الكتابة في سجلّ يراه الجميع.
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$bid": { ".validate": "newData.isBoolean()" }
      }
    },
    "blog": {
      // ══ المدوّنة ══
      // قراءة عامّة: الخادم يقرأ المقالات عبر REST بلا مفتاح ليُصيّرها
      // في HTML (شرط الفهرسة). والمسوّدات مقروءة أيضاً — ولا ضرر:
      // صفحة المقال ترفض عرض ما ليس `published`، والمسوّدة ليست سرّاً
      // بل مقالٌ لم يُنشر بعد.
      // الكتابة للأدمن وحده — كما `guide/specialities` تماماً.
      ".read": true,
      "index": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".indexOn": ["publishedAt", "status"],
        "$postId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['slug','title','status']) && newData.child('slug').val().length <= 80 && newData.child('title').val().length <= 200 && (newData.child('status').val() === 'draft' || newData.child('status').val() === 'published'))"
        }
      },
      "content": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$postId": {
          // حدّ الحجم يحمي الباقة: مقال ٣٠٠ ألف حرف ليس مقالاً
          ".validate": "!newData.exists() || (newData.hasChild('html') && newData.child('html').val().length <= 300000)"
        }
      }
    },
    "guide": {
      ".read": true,
      "specialities": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$slug": {
          ".validate": "!newData.exists() || ((!newData.hasChild('permalink') || newData.child('permalink').val().matches(/^[a-z0-9-]{1,60}$/)) && (!newData.hasChild('title') || newData.child('title').val().length <= 200) && (!newData.hasChild('excerpt') || newData.child('excerpt').val().length <= 400))"
        }
      }
    },
    "moderation": {
      ".read": "auth != null",
      "leaderboardExcluded": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$uid": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "chargilyOrders": {
      "$orderId": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "chargilyPayments": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "activity": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "teacherSales": {
      "$ownerId": {
        ".read": "auth != null && (auth.uid === $ownerId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "teacherContact": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('visibility').val() === 'public')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "!newData.exists() || newData.child('visibility').val().matches(/^(public|private)$/)"
      }
    },
    "pageOverrides": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "courses": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "teacherId",
        "status",
        "updatedAt",
        "createdAt"
      ],
      "$courseId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('teacherId').val() === auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.exists() && (root.child('users').child(auth.uid).child('role').val() === 'teacher' || root.child('users').child(auth.uid).child('role').val() === 'admin') && newData.child('teacherId').val() === auth.uid && newData.child('status').val() === 'draft') || (data.exists() && newData.exists() && data.child('teacherId').val() === auth.uid && newData.child('teacherId').val() === auth.uid && (data.child('status').val() === 'draft' || data.child('status').val() === 'changes' || data.child('status').val() === 'rejected') && (newData.child('status').val() === 'draft' || newData.child('status').val() === 'submitted' || newData.child('status').val() === data.child('status').val())) || (data.exists() && !newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'teacher' && data.child('teacherId').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['title','teacherId','status','type','subject']) && newData.child('title').isString() && newData.child('title').val().length <= 160 && newData.child('type').val().matches(/^(free|paid)$/) && newData.child('status').val().matches(/^(draft|submitted|review|changes|rejected|approved|published|unpublished)$/) && (!newData.hasChild('price') || (newData.child('price').isNumber() && newData.child('price').val() >= 0)) && (!newData.hasChild('shortDesc') || newData.child('shortDesc').val().length <= 300) && (!newData.hasChild('fullDesc') || newData.child('fullDesc').val().length <= 4000))"
      }
    },
    "courseContent": {
      "$courseId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('courses').child($courseId).child('teacherId').val() === auth.uid || root.child('purchases').child(auth.uid).child('course').child($courseId).exists() || (root.child('coursesPublic').child($courseId).child('type').val() === 'free' && root.child('coursesPublic').child($courseId).child('status').val() === 'published' && root.child('courseEnrollments').child($courseId).child(auth.uid).exists()))",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('courses').child($courseId).child('teacherId').val() === auth.uid && (!newData.exists() || root.child('courses').child($courseId).child('status').val() === 'draft' || root.child('courses').child($courseId).child('status').val() === 'changes' || root.child('courses').child($courseId).child('status').val() === 'rejected')))"
      }
    },
    "coursesPublic": {
      ".read": true,
      ".indexOn": [
        "publishedAt",
        "subject",
        "type"
      ],
      "$courseId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('courses').child($courseId).child('teacherId').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['title','teacherId','status']) && newData.child('status').val() === 'published')"
      }
    },
    "courseEnrollments": {
      "$courseId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (root.child('coursesPublic').child($courseId).child('type').val() === 'free' && root.child('coursesPublic').child($courseId).child('status').val() === 'published'))) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "!newData.exists() || newData.hasChild('at')"
        }
      }
    },
    "userCourses": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "courseProgress": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$courseId": {
          ".validate": "!newData.exists() || (!newData.hasChild('percent') || (newData.child('percent').isNumber() && newData.child('percent').val() >= 0 && newData.child('percent').val() <= 100))"
        }
      }
    },
    "courseReviews": {
      ".read": true,
      "$courseId": {
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && (root.child('purchases').child(auth.uid).child('course').child($courseId).exists() || (root.child('coursesPublic').child($courseId).child('type').val() === 'free' && root.child('courseEnrollments').child($courseId).child(auth.uid).exists()))) || (auth.uid === $uid && !newData.exists()) || (!newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "!newData.exists() || (newData.hasChildren(['stars','name','at']) && newData.child('stars').isNumber() && newData.child('stars').val() >= 1 && newData.child('stars').val() <= 5 && newData.child('at').isNumber() && newData.child('at').val() <= now && newData.child('name').isString() && newData.child('name').val().length <= 80 && (!newData.hasChild('comment') || newData.child('comment').val().length <= 500))"
        }
      }
    },
    "courseReviewThreads": {
      "$courseId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('courses').child($courseId).child('teacherId').val() === auth.uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$msgId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['byUid','text','at']) && newData.child('byUid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 1000)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('courses').child($courseId).child('teacherId').val() === auth.uid && !data.exists() && newData.exists()))"
        }
      }
    },
    "teacherCourses": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "roomExamPapers": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid)",
          ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.exists() && root.child('roomLive').child($roomId).child('exam').exists()) || (!newData.exists() && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['name','submittedAt']) && newData.child('submittedAt').isNumber() && newData.child('name').isString() && newData.child('name').val().length <= 80 && (!newData.hasChild('text') || newData.child('text').val().length <= 8000) && (!newData.hasChild('violations') || newData.child('violations').isNumber()))"
        }
      }
    },
    "roomExamGrades": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
        ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['score','max','gradedAt','released']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('max').isNumber() && newData.child('max').val() > 0 && newData.child('score').val() <= newData.child('max').val() && newData.child('released').isBoolean() && (!newData.hasChild('notes') || newData.child('notes').val().length <= 1500))"
        }
      }
    },
    "studyFeed": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt",
        "type"
      ],
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$itemId": {
        ".validate": "!newData.exists() || (newData.hasChildren(['type','title','createdAt']) && newData.child('title').isString() && newData.child('title').val().length <= 200 && (!newData.hasChild('xp') || (newData.child('xp').isNumber() && newData.child('xp').val() >= 0 && newData.child('xp').val() <= 40)))"
      }
    },
    "feedVotes": {
      "$itemId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists() && root.child('studyFeed').child($itemId).exists()) || (!newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "!newData.exists() || (newData.hasChild('at') && newData.child('at').isNumber() && (!newData.hasChild('choice') || newData.child('choice').isNumber()) && (!newData.hasChild('text') || newData.child('text').val().length <= 2000))"
        }
      }
    },
    "feedProgress": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$itemId": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChild('at') && newData.child('at').isNumber() && newData.child('at').val() <= now && (!newData.hasChild('xpClaimed') || (newData.child('xpClaimed').isNumber() && newData.child('xpClaimed').val() <= 40 && newData.child('xpClaimed').val() <= root.child('studyFeed').child($itemId).child('xp').val()))"
        }
      }
    },
    "dailyMissions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$id": {
        ".validate": "!newData.exists() || (newData.hasChildren(['title','kind','target']) && newData.child('target').isNumber() && newData.child('target').val() >= 1 && (!newData.hasChild('xp') || (newData.child('xp').isNumber() && newData.child('xp').val() >= 0 && newData.child('xp').val() <= 40)))"
      }
    },
    "missionClaims": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$day": {
          "$missionId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.hasChildren(['xp','at']) && newData.child('at').isNumber() && newData.child('xp').isNumber() && newData.child('xp').val() >= 0 && newData.child('xp').val() <= root.child('dailyMissions').child($missionId).child('xp').val()"
          }
        }
      }
    },
    "missionManual": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sessionReminders": {
      ".read": "auth != null",
      "$sessionId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}