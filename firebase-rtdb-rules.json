{
  "rules": {
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "name",
        "email",
        "points"
      ],
      "$uid": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && (!newData.hasChild('role') || newData.child('role').val() === 'student' || newData.child('role').val() === 'teacher')) || (auth.uid === $uid && data.exists() && (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val())))"
      }
    },
    "community": {
      ".read": "auth != null",
      "posts": {
        ".indexOn": [
          "createdAt",
          "authorId"
        ],
        "$postId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('authorId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')))",
          "votes": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid"
            }
          },
          "commentCount": {
            ".write": "auth != null"
          },
          "locked": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
          }
        }
      },
      "comments": {
        "$postId": {
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('authorId').val() === auth.uid || root.child('community').child('posts').child($postId).child('authorId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')))"
          }
        }
      },
      "postAttachments": {
        ".write": "auth != null"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && ($from === auth.uid || $uid === auth.uid)"
        }
      }
    },
    "sentRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "dms": {
      "$threadId": {
        ".read": "auth != null && $threadId.contains(auth.uid)",
        ".write": "auth != null && $threadId.contains(auth.uid)"
      }
    },
    "dmThreads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null"
    },
    "groups": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt",
        "subject"
      ],
      "$groupId": {
        ".write": "auth != null && (!data.exists() && newData.child('ownerId').val() === auth.uid || (data.exists() && !newData.exists() && data.child('ownerId').val() === auth.uid))"
      }
    },
    "groupMembers": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('groups').child($groupId).child('ownerId').val() === auth.uid",
        "$uid": {
          ".write": "auth != null && ($uid === auth.uid || root.child('groups').child($groupId).child('ownerId').val() === auth.uid)"
        }
      }
    },
    "groupMessages": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "createdAt"
        ]
      }
    },
    "groupFiles": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "userGroups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "type",
        "name"
      ],
      "$roomId": {
        ".write": "auth != null",
        "messages": {
          ".write": "auth != null"
        }
      }
    },
    "scheduledSessions": {
      ".read": "auth != null",
      "$sessionId": {
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid)"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$roomId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "flashcards": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "studyProgress": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "bannedUsers": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        }
      }
    },
    "roomLive": {
      "$roomId": {
        ".read": "auth != null",
        "mods": {
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
          }
        },
        "poll": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
          "votes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "kicked": {
          "$uid": {
            ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
          }
        },
        "activeTool": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
        },
        "videoState": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        },
        "whiteboard": {
          ".write": "auth != null"
        },
        "voice": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
          }
        },
        "hands": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('roomLive').child($roomId).child('mods').child(auth.uid).exists())"
          }
        },
        "timer": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
          ".read": "auth != null"
        },
        "notes": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid",
          ".read": "auth != null"
        },
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "activeFile": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('ownerId').val() === auth.uid"
        }
      }
    },
    "library": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (!data.exists() && newData.child('uploaderId').val() === auth.uid || data.exists() && !newData.exists() && (data.child('uploaderId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'))"
      }
    }
  }
}