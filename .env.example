# ── Firebase (الباقة المجانية Spark) ──────────────────────────────
# من: Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=studylinkchatapp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://studylinkchatapp-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studylinkchatapp
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── تخزين الملفات (بلا بطاقة) — اختر واحداً لاحقاً ─────────────────
# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── الصوت: Cloudflare Realtime (يُملأ في مرحلة الصوت) ─────────────
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# ── Omibot: Google Gemini (يُملأ في مرحلة الذكاء الاصطناعي) ───────
# سرّي — لا يبدأ بـ NEXT_PUBLIC (يبقى في الخادم فقط)
GEMINI_API_KEY=

# Google Drive (رفع وعرض الملفات) — OAuth Client ID من Google Cloud
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web Push (إشعارات المتصفّح) — احصل عليها بتشغيل: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@baczonedz.com
